<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yourname.slotgame" version="1.0.0" xmlns="http://www.w3.org/ns/widgets">
  <name>Lucky Spin Slot</name>
  <description>Aplikasi landing slot game</description>
  <author email="fabrique@azerion.com" href="https://azerion.com/">Azerion Productions B.V.</author>
  <content src="index.html" />
  <icon src="res/icon.png" />
  <preference name="Fullscreen" value="true" />
  <preference name="DisallowOverscroll" value="true" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <platform name="android">
    <preference name="Orientation" value="sensorLandscape" />
    <allow-intent href="market:*" />
  </platform>
  <platform name="ios">
    <preference name="Orientation" value="landscape" />
    <allow-intent href="itms:*" />
    <allow-intent href="itms-apps:*" />
  </platform>
</widget>
